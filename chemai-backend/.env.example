# ChemAI Backend Environment Configuration
# 复制此文件为.env并填写实际值

# ===================
# DeepSeek（对话讲评、出题/诊断/家长报告、搜索结果总结都走它）
# ===================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名：deepseek-flash 是思考模型（V4.1 Flash，原生多模态），reasoning token 算在
# max_tokens 之内；固定格式通路会显式关思考，对话讲评那条留着。上下文窗口按模型查表
# （见 app/config.py 的 MODEL_CONTEXT_WINDOWS），换模型不用另外设 CONTEXT_WINDOW。
DEEPSEEK_MODEL=deepseek-flash

# ===================
# AnySearch（联网搜索主通道：web_search 工具与真题的网络补充）
# ===================
# 不配也能跑，但会掉到 mimo 内置搜索 / Bing 抓取那两条兜底通道上——它们返回的是网页
# 原文，来源可验证性差，而这正是真题场景要的东西（agent/tools/exam_bank.py:165）。
ANYSEARCH_API_KEY=your_anysearch_api_key_here

# ===================
# 可选兜底通道（留空即跳过对应通路，不会报错）
# ===================
# MiMo 既当文本 provider（内置搜索兜底、auto 链里 DeepSeek 之后的那一位），也当第二家视觉
# 后端 —— 但**不能是同一个型号**：实测 `mimo-v2.6-flash` 对 image_url + data: URI 回 400，
# 同一张图在 `mimo-v2.6-pro` / `mimo-v2.5` 上都能读对。所以视觉另开一个型号名。
XIAOMI_API_KEY=your_xiaomi_api_key_here
MIMO_MODEL=mimo-v2.6-flash
MIMO_VISION_MODEL=mimo-v2.6-pro
DASHSCOPE_API_KEY=your_dashscope_api_key_here   # 只作 auto 链最后的文本兜底。
# 它**不再**是 embedding 通路：知识点/相似题向量改在本机算（ADR-0024），留空也不会退回伪向量。

# 模型出口录放（ADR-0023）：默认 live 即这层不存在。record 只该由评估入口显式开——
# 服务器进程带着 record 启动会当场拒绝；replay 只读磁带，可用来离线复现。
# CHEMAI_LLM_MODE=live
# CHEMAI_CASSETTE_DIR=../cassettes

# ===================
# 答题卡 OCR 与文档解析
# ===================
# OCR 用哪个后端：paddle（默认，本地 PP-OCRv6，不需要密钥）/ baidu / mineru。
# 答题卡批处理与老师上传文档/图片**共用这一个键**（ADR-0025）：以前上传那条绕过注册表直接打
# 百度教育接口，于是没配 BAIDU_OCR_* 的机器上"图片解析"根本没有引擎。现在不需要了。
# 写一个认不出的值会退回 mineru 而不是报错（app/services/ocr_mineru.py 的 get_ocr_provider）。
OCR_SHEET_PROVIDER=paddle
# MinerU：试卷/PDF 的结构化解析，走本机 CLI。要可执行文件与模型都在位——模型没下载时
# 健康检查会报"需先下载模型"，解析会退回其它后端。
MINERU_ENABLED=1
# MINERU_PATH=                      # 留空则自动找：已 pip 装的 mineru 包 → 上面的源码检出
# 模型来源。`local` = 直接用 `~/mineru.json` 里 models-dir 记的那个目录。不设这一行会按
# 下载时的来源（modelscope/huggingface）去**默认缓存**找，那在 C 盘：找不到就当没下过，
# 重新往 C 盘下几 G。模型放到别的盘的机器上必须设 local。
MINERU_MODEL_SOURCE=local
# ── 本地 embedding（知识点/相似题向量检索，ADR-0024）──
# 型号戳会写进 Chroma collection 的 metadata：换了 EMBEDDING_MODEL 会整库重建（同维度也重建）
# —— 旧向量留在同一个余弦空间里才是真危险。
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 模型缓存目录，两个键认第一个（EMBEDDING_CACHE_DIR 优先，其次 HF_HOME）。**必配**：
# 都不给就直接拒绝加载模型，因为默认落点是用户目录下的 .cache\huggingface —— 那是 1.3G
# 掉进系统盘。目录里还没有模型时按 huggingface 的布局用 <该目录>/hub；已经含
# models--BAAI--... 的目录（就是 hub 那一层本身）就地用，不再往里拼一层 hub，拼了会
# 认成空目录再下 2.5G。
# EMBEDDING_CACHE_DIR=D:\hf-cache
# HF_HOME=D:\hf-cache
# 跑推理的设备。默认 cpu；有卡才写 cuda。
# EMBEDDING_DEVICE=cpu
# 换过型号之后重建全量索引（约 800 条 / CPU 上 8 分钟，动手前会先备份 data/chromadb）：
#     python _datagen/reindex_vectors.py

# ── 本机库文件的位置（只有这一处定义，其余代码读 settings）──
# 对话 checkpoint 与 agent store 是两个独立的 sqlite 文件，`agent/channel/conversation.py`
# 里还有按线程删 checkpoint 的语句；`MEMORY_DATA_DIR` 是学生画像那套 markdown 记忆。
# 测试与评估（`app/shadow_data.py`）默认会把这三件连同 chemai.db、向量索引一起复制成影子，
# 所以只有"想把它们搬到别的盘"或"要让测试跑在指定副本上"时才需要设。
# CHECKPOINT_DB_PATH=D:\chemai_checkpoints.db
# STORE_DB_PATH=D:\chemai_store.db
# MEMORY_DATA_DIR=D:\chemai_memory

# 视觉复核：OCR 结果可疑时再让多模态看一遍原图。目前只有能看图型号的 DeepSeek 能做
# （DEEPSEEK_MODEL=deepseek-flash）；后端一个都没有时静默跳过，不会判识别失败。
OCR_VISION_REVIEW_ENABLED=1

# ===================
# 通义千问API (LLM)
# ===================
LLM_MODEL=qwen-turbo

# ===================
# 腾讯OCR API
# ===================
TENCENT_OCR_SECRET_ID=your_tencent_secret_id_here
TENCENT_OCR_SECRET_KEY=your_tencent_secret_key_here
TENCENT_OCR_REGION=ap-guangzhou

# ===================
# 数据库配置
# ===================
# SQLite (开发/MVP)
DATABASE_URL=sqlite:///./chemai.db

# MySQL (生产环境推荐)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/chemai

# ===================
# Chroma向量数据库
# ===================
# 注意：路径必须纯 ASCII。chroma-hnswlib 的 C++ ofstream 在含中文的路径上写不出
# hnsw 段文件（pickle/sqlite 正常、bin 永远缺失），重启即 "Cannot open header file"
# → 全量重编码（2026-10-31 实锤，仓库曾因此把向量库迁到 C:/chemai-chromadb）。
CHROMA_DB_PATH=./data/chromadb

# ===================
# 化学知识图谱
# ===================
KNOWLEDGE_GRAPH_PATH=./data/knowledge_graph
EXAM_QUESTIONS_PATH=./data/exam_questions

# ===================
# 应用配置
# ===================
DEBUG=true
APP_NAME=智辅化学 ChemAI
APP_VERSION=1.0.0

# ===================
# OCR配置
# ===================
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE=10485760

# ===================
# 化学方程式审核配置
# ===================
BALANCE_CHECK_ENABLED=true
CONDITION_CHECK_ENABLED=true
PRODUCT_CHECK_ENABLED=true
STRUCTURE_CHECK_ENABLED=true

# ===================
# 障碍诊断默认值
# ===================
DEFAULT_CONCEPT_THRESHOLD=3
DEFAULT_READING_THRESHOLD=2
DEFAULT_EXPRESSION_THRESHOLD=3
DEFAULT_MASTERY_THRESHOLD=3

# ===================
# JWT密钥 (生产环境请务必修改)
# ===================
# 签 JWT 的密钥。**必须换掉**：不设的话 auth.py 退回它那个硬编码默认值，而那个值是公开的
# （就写在本文件与源码里），等于任何人都能给自己签一张管理员票。换它会作废所有已签发的
# token，也就是所有人要重登一次，所以选在部署窗口做。生成一把：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHEMAI_JWT_SECRET=paste_a_generated_random_secret_here

# ===================
# CORS白名单 (生产环境请设置具体域名，逗号分隔)
# ===================
# CHEMAI_CORS_ORIGINS=http://localhost:8001,https://yourdomain.com

# ===================
# 服务端口
# ===================
# CHEMAI_PORT=8001
